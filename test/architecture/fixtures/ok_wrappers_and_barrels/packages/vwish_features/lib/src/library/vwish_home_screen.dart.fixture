// A Slider, a Card and an AlertDialog in a comment do not count.
/* Nor in a block comment: TextField(), IconButton(). */
import 'package:flutter/widgets.dart';
import 'package:vwish_ui_kit/vwish_ui_kit.dart';

/// Uses kit wrappers only; `Chip` in dartdoc does not count either.
class VwishHomeScreen extends StatelessWidget {
  const VwishHomeScreen({super.key, this.mode = 0});

  final int mode;

  @override
  Widget build(BuildContext context) {
    const label = 'Card Slider Switch Chip';
    final cardColor = VwishColors.surface;
    switch (mode) {
      case 0:
        return VwishIconButton(icon: VwishIcons.edit, semanticLabel: '$label ${cardColor.toString()}');
      default:
        return VwishTextField(hint: "Search: TextField('x')", sliderTheme: VwishSliderThemeData());
    }
  }
}
